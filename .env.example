# ============================================================
# Aspire configuration — copy this file to .env and fill in
# ============================================================

# REQUIRED: Anthropic API key for Claude Haiku slide descriptions
# Lab members: contact Dr. Jonggi Hong for the lab's API key.
# External users: get your own at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here

# ============================================================
# OPTIONAL: Capture configuration
# ============================================================

# Video capture device index (default: 3:0 = first screen)
# If iPhone connected via Continuity Camera, may need to be 4:0
# Find correct index: ffmpeg -hide_banner -f avfoundation -list_devices true -i ""
# ASPIRE_AVFOUNDATION_INPUT=3:0

# Audio capture backend
# Default: sck_cli (ScreenCaptureKit via tools/systemAudioDump)
# Legacy:  blackhole (requires BlackHole 2ch installed)
# ASPIRE_AUDIO_CAPTURE=sck_cli

# ============================================================
# OPTIONAL: Debugging
# ============================================================

# Disable silence compression (causes listener latency to grow — debug only)
# ASPIRE_DISABLE_COMPRESSION=1
